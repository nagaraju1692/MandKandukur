{
  "expo": {
    "name": "ManaKandukur Mobile",
    "slug": "nagaraju",
    "version": "1.0.12",
    "orientation": "portrait",
    "icon": "./src/assets/manakundur-app-icon-square.png",
    "splash": {
      "image": "./src/assets/manakundur-app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.manakandukur.directory",
      "versionCode": 13,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/manakundur-app-icon-square.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./src/assets/manakundur-app-icon-square.png",
          "color": "#514BD5"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow ManaKandukur to use microphone for voice search."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ManaKandukur to access your location to find nearby businesses."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d8adb304-e13a-47b0-9430-0ba3cf729ca5"
      }
    }
  }
}